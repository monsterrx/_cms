APP_NAME=MonsterCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_CODE=mnl
APP_URL=http://localhost:9001
APP_TIMEZONE=Asia/Manila
ASSET_URL=http://localhost:9001
FRONTEND_URL=http://localhost:9001
MEDIA_URL_MNL=https://rx931.com
MEDIA_URL_CBU=https://monstercebu.com
MEDIA_URL_DAV=https://monsterdavao.com
MEDIA_VERIFY_REMOTE=true
MEDIA_REMOTE_TIMEOUT=3
MEDIA_EXISTS_CACHE_SECONDS=600
SANCTUM_STATEFUL_DOMAINS=localhost:9001,127.0.0.1:9001,localhost:8000,127.0.0.1:8000,localhost:3000,127.0.0.1:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3309
DB_DATABASE=rxninthr_monster
DB_USERNAME=monster
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
APP_PORT=9001
FORWARD_DB_PORT=3309

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=monster-control-room@rx931.com
MAIL_FROM_NAME="${APP_NAME}"
BUG_REPORT_TO=sean@rx931.com
BUG_REPORT_CC=seanphilipcruz@gmail.com
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
